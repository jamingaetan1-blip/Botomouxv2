# Copier ce fichier en .env (a cote de docker-compose.yml) et remplir les valeurs.
# Ne jamais commiter le fichier .env.

# Jeton du bot Discord (obligatoire).
TOKEN=

# --- Dofus Craft (facultatif) ---
# Sans ces deux valeurs, le bot fonctionne exactement comme avant.
# Adresse et cle donnees par le proprietaire du site.
DOFUS_CRAFT_API_URL=
FM_BOT_API_KEY=

# --- Salons FM personnels (facultatif) ---
# 1 pour activer le bouton et les salons personnels. Sur chaque serveur ou il se trouve (et
# des qu'on l'ajoute a un serveur), le bot cree lui-meme les categories
# "Forgemagie" et "Archives FM" et le salon d'accueil #forgemagie (il lui faut la
# permission "Gerer les salons").
FM_PERSONAL_CHANNELS=0
FM_MAX_ACTIVE_CHANNELS=5
# Image du message d'accueil (vide pour aucune image). Par defaut, le Zaap servi par le site.
FM_WELCOME_IMAGE_URL=https://dofus-craft.dofus-craft.workers.dev/fm-banner.jpg
FM_INACTIVITY_DAYS=14
# 1 pour archiver les salons d'un joueur qui quitte le serveur
# (demande d'activer "Server Members Intent" dans le portail developpeur Discord).
FM_MEMBERS_INTENT=0
